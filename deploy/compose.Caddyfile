# Standalone Caddy config for docker-compose. The drust image defaults to
# DRUST_BASE_PATH="" (root mode), so drust's browser-facing URLs (form actions,
# redirects, cookie paths, OAuth callbacks) carry NO "/drust" prefix — Caddy
# proxies the root path straight through to drust.
#
# If you instead run the drust service with DRUST_BASE_PATH=/drust (proxy mounts
# it under a subpath), switch this to the `handle_path /drust/*` form from the
# production deploy/Caddyfile snippet so Caddy strips the prefix back off.
#
# /public/* belongs to the object store, not to drust: a public object is served
# straight out of the "public" bucket and never reaches drust (CLAUDE.md
# invariants 14 and 19). PUBLIC_OBJECTS_UPSTREAM (a variable of the caddy
# container, set in docker-compose.yml) picks the store:
#   rustfs:9000   the bundled RustFS (docker-compose.storage.yml)   default, no edit
#   minio:9000    a MinIO you run yourself (S3 API, path-style)      no edit expected;
#                 untested in this release
#   garage:3902   a Garage s3_web endpoint                           ALSO replace the
#                 two lines marked STORE-SHAPE with the Garage forms in their comments
# Every line of the block is load-bearing:
#   - handle_path + "rewrite * /public{path}?" pins the bucket from config: Caddy
#     matches the CLEANED path but forwards the RAW one, so without the strip and
#     re-add, /private/../public/x would reach the store as bucket "private".
#   - The "?" ending that rewrite DROPS THE QUERY STRING: an S3 API honours
#     ?response-content-type= on anonymous GETs, which would re-serve any public
#     object as an unsandboxed TEXT/HTML (the matcher below is case-sensitive).
#   - GET/HEAD only. Authorization and Cookie never reach the store (an S3 API
#     answers 400 to a drust bearer, and the admin session cookie is same-origin).
#     Set-Cookie from the store never reaches the browser: this is the admin UI's
#     origin, and a store (or a misconfigured upstream) must not set cookies on it.
#   - @markup must stay in lockstep with storage::files::is_unsafe_inline_type
#     (pinned by deploy/tests/compose_public_route_test.sh) and with the bare-metal
#     host's block in ../garage/deploy/Caddyfile (outside this repo: checked by
#     hand). copy_response is MANDATORY inside
#     handle_response: without it the body is silently dropped (200, 0 bytes).
# Verified on Caddy 2.11.9 (the image `caddy:2` resolved to it); docker-compose.yml
# keeps the floating `caddy:2` tag so the proxy keeps receiving security releases.
:80 {
	handle_path /public/* {
		@write not method GET HEAD
		respond @write 405
		rewrite * /public{path}? # STORE-SHAPE. Garage s3_web form: rewrite * {path}?
		reverse_proxy {$PUBLIC_OBJECTS_UPSTREAM:rustfs:9000} {
			header_up Host {upstream_hostport} # STORE-SHAPE. Garage s3_web form: header_up Host "public.web.local"
			header_up -Authorization
			header_up -Cookie
			header_down X-Content-Type-Options "nosniff"
			header_down -Set-Cookie

			@markup {
				header Content-Type text/html
				header Content-Type text/html;*
				header Content-Type text/xml
				header Content-Type text/xml;*
				header Content-Type application/xml
				header Content-Type application/xml;*
				header Content-Type text/xsl
				header Content-Type text/xsl;*
				header Content-Type *+xml
				header Content-Type *+xml;*
			}
			handle_response @markup {
				header Content-Security-Policy "sandbox allow-top-navigation-by-user-activation"
				copy_response
			}
		}
	}

	handle {
		reverse_proxy drust:47826 {
			header_up Host "127.0.0.1:47826" # rmcp DNS-rebinding guard (MCP needs a loopback Host)
			# drust keys its per-IP rate limits on X-Forwarded-For, which Caddy sets by
			# default and — with no `trusted_proxies` configured — rebuilds from the TCP
			# peer, so it carries exactly one entry: DRUST_TRUSTED_PROXIES=1 in
			# docker-compose.yml. X-Real-IP is informational; drust does not read it.
			# If you put a proxy in front of this Caddy and trust it (Caddy 2.x: the
			# global `servers { trusted_proxies static <cidr> }` option), Caddy keeps
			# that proxy's entries — raise DRUST_TRUSTED_PROXIES to match.
			header_up X-Real-IP {remote_host}
		}
	}

	# Convenience: bare root → the admin login (the route is /login, not /admin/login).
	redir / /login
}
