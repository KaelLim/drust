[Unit]
Description=Drust multi-tenant SQLite BaaS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drust
Group=drust
WorkingDirectory=/home/kaelsohappy1/tool/drust
EnvironmentFile=/home/kaelsohappy1/tool/drust/.env
ExecStart=/home/kaelsohappy1/tool/drust/target/release/drust
Restart=on-failure
RestartSec=5s
# Backstop, not the mechanism. drust bounds its own connection drain at
# DRUST_SHUTDOWN_GRACE_SECS (default 10) and then flushes the audit buffer, so
# it should exit well inside this. The default 90s mattered because before
# v1.58.3 shutdown waited forever on long-lived streams (MCP sessions, SSE, WS)
# and every stop ended in SIGKILL — which skips the audit flush entirely. Keep
# this comfortably ABOVE the in-process grace; lowering it under that value just
# reinstates the SIGKILL.
TimeoutStopSec=30s
UMask=0077
# Webhook fan-out knobs (all have working Rust defaults; listed here so they
# are discoverable together on this deploy target — Compose carries the same
# set; the on-hold Helm chart is not kept in step):
#   DRUST_WEBHOOK_MAX_CONCURRENCY  deliveries in flight process-wide (default 64)
#   DRUST_WEBHOOK_MAX_PER_TENANT   webhook registrations per tenant (default 32)
#   DRUST_WEBHOOK_MAX_PER_TENANT_CONCURRENCY  deliveries in flight PER TENANT
#                                  (default 8) — a sub-cap under MAX_CONCURRENCY
#                                  so one tenant's fan-out cannot starve others
# Caller-SQL deadline (also has a working Rust default; Compose lists it too):
#   DRUST_QUERY_DEADLINE_MS  caller-SQL deadline in ms (default 5000, 0 disables):
#                            every read RPC / raw query, and anon+user write RPCs
# Client-IP derivation (working Rust default; the image and Compose set their own):
#   DRUST_TRUSTED_PROXIES    appending proxies in front of drust (default 2 =
#                            nginx -> Caddy on this host; range 0-8, 0 = TCP peer)
# MCP (all optional, working Rust defaults — Compose carries the same set; the
# on-hold Helm chart is not kept in step). DRUST_MCP governs the account-level
# MCP endpoint <DRUST_PUBLIC_URL>/drust/mcp and its OAuth authorization server.
# This host is mounted under /drust, so `auto` (the default) never enables MCP.
# The order: paste the two root /.well-known/* rules from deploy/Caddyfile into
# /etc/caddy/Caddyfile and have the TLS upstream forward them (no 30x), then set
# DRUST_MCP=on in the EnvironmentFile, then run the release gate in
# .claude/rules/build-deploy.md.
#   DRUST_MCP                          auto | on | off (default auto)
#   DRUST_MCP_OAUTH_ACCESS_TTL_SECS    access token lifetime (default 3600; 900..=86400)
#   DRUST_MCP_OAUTH_REFRESH_GRACE_SECS refresh retry grace (default 60; 0..=300)
#   DRUST_MCP_OAUTH_IDLE_DAYS          grant idle expiry (default 30; 1..=MAX_DAYS)
#   DRUST_MCP_OAUTH_MAX_DAYS           grant absolute expiry (default 90; 1..=365)
# With `on`, DRUST_PUBLIC_URL must be the public https origin with no path: it
# is the OAuth issuer origin and the MCP resource origin, not DRUST_PUBLIC_BASE_URL
# (a loopback http:// origin is accepted with a warning, for development only);
# an unusable DRUST_PUBLIC_URL or DRUST_BASE_PATH leaves MCP off with one error
# line. Never let RUST_LOG raise `rmcp` to debug or trace: it then logs whole
# MCP requests and results, upload tickets included.
# The semaphore bounds concurrent deliveries; this NOFILE floor keeps FD
# headroom for SQLite handles + SSE/WS alongside those sockets.
LimitNOFILE=65536

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/drust /var/log/drust
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
# NOTE: MemoryDenyWriteExecute is intentionally NOT set. Edge functions
# (v1.36+) JIT-compile guest wasm via wasmtime's Cranelift backend, which
# must make anonymous memory executable; W^X enforcement makes every
# function upload/invoke fail with "unable to make memory executable
# (EPERM)". The guest sandbox is enforced inside wasmtime (epoch deadline +
# ResourceLimiter memory cap + locked-down WasiCtx), not by this directive.

[Install]
WantedBy=multi-user.target
