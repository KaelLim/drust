# ──────────────────────────────────────────────────────────────
# drust configuration. Copy to .env and fill in real values.
# .env is gitignored; .env.example is committed for reference.
# ──────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
DRUST_LOG_DIR=/var/log/drust
DRUST_DATA_DIR=/var/lib/drust

# External URL path prefix. Your reverse proxy strips this before drust sees the
# request (e.g. Caddy `handle_path /drust/*`), so drust re-adds it to every
# browser-facing URL: redirects, cookie Paths, OAuth redirect_uri, admin links.
# Default "/drust" (matches a /drust-mounted proxy). Set to "" (empty) to serve
# at the ROOT path — the Docker image ships "" for a standalone root deployment.
DRUST_BASE_PATH=/drust

# Externally-reachable base URL of your drust deployment.
# Required when any OAuth provider is configured, and for MCP: it is the OAuth
# issuer and the origin of the MCP endpoint.
# Bare host with NO path suffix — drust appends DRUST_BASE_PATH (above) + "/...".
# So with DRUST_BASE_PATH=/drust, if you register the redirect_uri with Google as
#   https://drust.example.com/drust/admin/oauth/google/callback
# then DRUST_PUBLIC_URL=https://drust.example.com (no trailing slash, no path).
DRUST_PUBLIC_URL=

# Reverse proxies in front of drust that each APPEND one entry to
# X-Forwarded-For. The per-IP rate limits (admin + tenant login, register,
# OAuth callbacks, CLI device flow, anon file upload/delete and function
# invoke) key on the entry that many positions from the right; 0 ignores the
# header and keys on the TCP peer. nginx → Caddy → drust = 2 (the default);
# Caddy only = 1. Range 0-8; anything else refuses to boot. Never count a proxy
# that passes a client-supplied X-Forwarded-For through untouched.
# DRUST_TRUSTED_PROXIES=2

# MCP (all optional). DRUST_MCP governs the account-level MCP endpoint
# <DRUST_PUBLIC_URL><DRUST_BASE_PATH>/mcp and its OAuth authorization server.
# `auto` (the default) enables MCP only when DRUST_BASE_PATH is empty (the Docker
# image) and DRUST_PUBLIC_URL is a non-loopback https:// origin; with this
# file's DRUST_BASE_PATH=/drust it never does. A /drust-mounted host first adds
# the two root /.well-known/* rules from deploy/Caddyfile to its proxy (the TLS
# upstream must forward them, no 30x), then sets DRUST_MCP=on, then runs the
# release gate in .claude/rules/build-deploy.md. With `on`, DRUST_PUBLIC_URL (the
# Core block above) must be a bare https:// origin; a loopback http:// origin is
# accepted with a warning, for development only. An unusable DRUST_PUBLIC_URL or
# an invalid DRUST_BASE_PATH leaves MCP off with one error line; boot continues.
# drust normalizes DRUST_PUBLIC_URL for MCP only and leaves it untouched for the
# admin/tenant OAuth providers. Never let RUST_LOG raise `rmcp` to debug or
# trace: it then logs whole MCP requests and results, upload tickets included.
# Each description sits on its own line: systemd's EnvironmentFile= treats `#`
# as a comment only at the start of a line.
#
# auto | on | off
# DRUST_MCP=auto
# Access token lifetime in seconds; 900..=86400.
# DRUST_MCP_OAUTH_ACCESS_TTL_SECS=3600
# Refresh retry grace in seconds; 0..=300 (0 = strictest reuse detection).
# DRUST_MCP_OAUTH_REFRESH_GRACE_SECS=60
# A grant ends after this many days unused; 1..=MAX_DAYS.
# DRUST_MCP_OAUTH_IDLE_DAYS=30
# A grant ends this many days after approval, used or not; 1..=365.
# DRUST_MCP_OAUTH_MAX_DAYS=90

# ── Admin bootstrap (first boot only — afterwards canonical in meta.sqlite) ─
DRUST_INIT_ADMIN_USERNAME=admin
DRUST_INIT_ADMIN_PASSWORD=changeme

# ── Admin OAuth (v1.11+, all optional) ────────────────────────
# Leave a CLIENT_ID/SECRET pair empty to disable that provider.
# See docs/oauth-setup.md for the provider registration walkthrough.
DRUST_OAUTH_GOOGLE_CLIENT_ID=
DRUST_OAUTH_GOOGLE_CLIENT_SECRET=
DRUST_OAUTH_GITHUB_CLIENT_ID=
DRUST_OAUTH_GITHUB_CLIENT_SECRET=

# Comma-separated email allowlist (lowercased on parse).
# Required when any OAuth provider is configured.
DRUST_ADMIN_OAUTH_ALLOWED_EMAILS=

# ── Object storage (optional; any S3-compatible store) ───────
# The GARAGE_ names are historical: they configure any S3-compatible store
# (verified: RustFS, Garage). The bucket names and the SigV4 region string
# "garage" are fixed, so the store must accept both (README, Configuration).
# drust writes to two buckets, "public" and "private", and never creates
# them; boot logs a warning for each one it cannot list.
# On Docker Compose, .env next to docker-compose.yml is also what Compose reads
# for ${...}; deploy/compose-storage-env.sh adds the storage keys to it and
# refuses a .env that already points GARAGE_S3_ENDPOINT elsewhere.
GARAGE_S3_ENDPOINT=
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=
# Optional, Garage only: the admin API, used solely by the reconcile page to
# clean up buckets left from the retired per-tenant layout. Set both or
# neither; one alone is ignored with a warning at boot.
# GARAGE_ADMIN_ENDPOINT=
# GARAGE_ADMIN_TOKEN=
# Client-facing origin for file and signed URLs (including the ones MCP tools
# return), with no path (drust appends /public/<tenant>/<key>, /s/t/... and
# /t/<id>/... itself). The MCP endpoint's own URL comes from DRUST_PUBLIC_URL.
# Default http://localhost:8793; docker-compose.yml sets http://localhost.
# DRUST_PUBLIC_BASE_URL=http://localhost:8793

# ── Quota & guards ────────────────────────────────────────────
DRUST_DISK_MIN_FREE_PCT=20
DRUST_INDEX_LARGE_TABLE_ROWS=1000000

# v1.24 — audit log storage flag. Default is true (writes go to both
# JSONL and SQLite). Set to "false" or "0" after v1.25 validation to
# stop the JSONL writer. v1.26 removes this flag.
AUDIT_DUAL_WRITE=true

# v1.25 dev-only: when set to any value, drust_theme / drust_locale
# cookies are emitted WITHOUT the Secure attribute so they accept on
# plain-HTTP loopback. NEVER set in production — admin theme/locale
# preferences would then travel over plain HTTP if the upstream TLS
# terminator (.221 nginx for our deployment) is removed.
# DRUST_DEV_NO_SECURE_COOKIES=1
